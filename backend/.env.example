# ============================================
# JobGuard 环境变量配置
# 复制此文件为 .env 并填入真实值
# ============================================

# --- LLM API Keys ---
# 智谱AI（主力模型，永久免费）→ https://open.bigmodel.cn/
ZHIPU_API_KEY=your_zhipu_api_key_here

# DeepSeek 官方（企业背调推理，新用户100万token）→ https://platform.deepseek.com/
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# SiliconFlow（Embedding，永久免费）→ https://cloud.siliconflow.cn/
SILICONFLOW_API_KEY=your_siliconflow_api_key_here

# --- 数据库 ---
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=jobguard
MYSQL_PASSWORD=jobguard123
MYSQL_DATABASE=jobguard

# --- Chroma 向量数据库 ---
CHROMA_PERSIST_DIR=./data/chroma

# --- 应用配置 ---
APP_NAME=JobGuard
APP_VERSION=0.1.0
DEBUG=true
SECRET_KEY=change-me-to-a-random-secret-key

# --- CORS ---
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
