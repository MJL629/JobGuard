# ============================================
# JobGuard 环境变量配置
# 复制此文件为 .env 并填入真实值
# ============================================

# --- LLM API Keys ---
# 智谱AI（主力模型，永久免费）→ https://open.bigmodel.cn/
ZHIPU_API_KEY=your_zhipu_api_key_here

# DeepSeek 官方（企业背调推理，新用户100万token）→ https://platform.deepseek.com/
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# SiliconFlow（Embedding，永久免费）→ https://cloud.siliconflow.cn/
SILICONFLOW_API_KEY=your_siliconflow_api_key_here

# Optional OpenAI-compatible local vLLM service.
VLLM_BASE_URL=http://localhost:8000/v1
VLLM_API_KEY=EMPTY
VLLM_MODEL=qwen2.5-7b
LLM_PRIMARY_PROVIDER=vllm_local
LLM_REASONING_PROVIDER=vllm_local

# Bounded concurrency for batch job matching (recommended: 1/2/4/8 in benchmarks)
JOB_MATCH_LLM_CONCURRENCY=4

# --- 可选 LangSmith（默认关闭；只建议在脱敏测试数据上启用）---
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=jobguard-local-evaluation

# --- 真实外部数据接口（可选，需要自行开通对应服务）---
# 企查查开放平台：配置后可查询企业工商照面/模糊搜索等真实接口
QICHACHA_APP_KEY=
QICHACHA_SECRET_KEY=
QICHACHA_BASE_URL=https://api.qichacha.com

# 阿里云市场企业工商/风险类 API：不同商品 URL 不同，购买后填入接口 URL 与 AppCode
ALIYUN_COMPANY_APPCODE=
ALIYUN_COMPANY_QUERY_URL=
EXTERNAL_API_TIMEOUT_SECONDS=10

# --- Agent 执行保护 ---
AGENT_MAX_STEPS=6
AGENT_TOOL_TIMEOUT_SECONDS=30

# --- 数据库 ---
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=jobguard
MYSQL_PASSWORD=jobguard123
MYSQL_DATABASE=jobguard

# --- Chroma 向量数据库 ---
CHROMA_PERSIST_DIR=./data/chroma

# --- 应用配置 ---
APP_NAME=JobGuard
APP_VERSION=0.1.0
DEBUG=true
SECRET_KEY=change-me-to-a-random-secret-key

# --- CORS ---
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
